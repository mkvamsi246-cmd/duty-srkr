# Copy this file to .env and fill in your real values

# --- Database ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=invigilation_db
PGUSER=postgres
PGPASSWORD=change_m

# --- Server ---
PORT=4000
NODE_ENV=production

# --- Admin login (simple single-admin auth) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_too
SESSION_SECRET=replace_with_a_long_random_string

# --- CORS (frontend URL, leave blank to allow same-origin only) ---
FRONTEND_ORIGIN=http://localhost:4000
